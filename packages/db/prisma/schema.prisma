generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      String   @default("dispatcher")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Technician {
  id              Int      @id @default(autoincrement())
  name            String
  phone           String?
  // JSON array of strings; SQLite has no native list type.
  skillTags       String   @default("[]") @map("skill_tags")
  hourlyCostCents Int      @map("hourly_cost_cents")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  appointments    Appointment[]

  @@map("technicians")
}

model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  contactEmail   String?  @map("contact_email")
  phone          String?
  serviceAddress String   @map("service_address")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  jobs           Job[]

  @@map("customers")
}

model Job {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  title       String
  description String?
  priority    String   @default("normal")
  status      String   @default("requested")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  customer    Customer @relation(fields: [customerId], references: [id])
  appointments Appointment[]

  @@index([customerId])
  @@map("jobs")
}

model Part {
  id             Int         @id @default(autoincrement())
  sku            String      @unique
  name           String
  unitCostCents  Int         @map("unit_cost_cents")
  unitPriceCents Int         @map("unit_price_cents")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  stockLevel     StockLevel?

  @@map("parts")
}

model StockLevel {
  id             Int      @id @default(autoincrement())
  partId         Int      @unique @map("part_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  part           Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("stock_levels")
}

model Appointment {
  id              Int        @id @default(autoincrement())
  jobId           Int        @map("job_id")
  technicianId    Int        @map("technician_id")
  scheduledStart  DateTime   @map("scheduled_start")
  scheduledEnd    DateTime   @map("scheduled_end")
  completionNotes String?    @map("completion_notes")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  job             Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician      Technician @relation(fields: [technicianId], references: [id])

  @@index([jobId])
  @@index([technicianId])
  @@map("appointments")
}
